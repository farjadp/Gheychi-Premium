# توکن بات تلگرام - از @BotFather بگیر
BOT_TOKEN=your_telegram_bot_token_here

# هندل عمومی بات، بدون @. اگر بات را عوض کردی این را هم عوض کن —
# و یادت باشد صفحات استاتیک website/ نمی‌توانند config را بخوانند،
# پس آن‌ها را هم جدا به‌روز کن.
BOT_USERNAME=gheychipremium_bot

# مسیر ذخیره فایل‌های دانلود شده (موقت)
DOWNLOAD_DIR=downloads

# حداکثر حجم فایل به مگابایت
MAX_FILE_SIZE_MB=50

# مسیر ذخیره تنظیمات و لاگ‌های پنل مدیریت
DATA_DIR=data

# پسورد پنل مدیریت وب
ADMIN_PASSWORD=change_me

# آیدی یا لینک پشتیبانی
SUPPORT_CONTACT=@gheychi_support

# دامنه عمومی سرویس — مبنای ساخت magic link داشبورد کاربر
# اگر ست نشود لینک‌ها به 127.0.0.1 اشاره می‌کنند
BASE_URL=https://your-domain.com

# کلید امضای magic link — حتماً یک رشته تصادفی قوی بگذار
# بدون این، یک مقدار fallback ثابت استفاده می‌شود و لینک‌ها قابل جعل‌اند
FLASK_SECRET_KEY=change_me_to_a_long_random_string

# کوکی‌های هر پلتفرم (اختیاری - برای محتوای نیاز به لاگین)
# هر کدام مسیر فایل cookies.txt مربوط به اون پلتفرم رو نشون میده
COOKIES_YOUTUBE=/data/cookies_youtube.txt
COOKIES_INSTAGRAM=/data/cookies_instagram.txt
COOKIES_TWITTER=/data/cookies_twitter.txt
COOKIES_TIKTOK=/data/cookies_tiktok.txt
COOKIES_FACEBOOK=/data/cookies_facebook.txt
COOKIES_SOUNDCLOUD=/data/cookies_soundcloud.txt
COOKIES_VIMEO=/data/cookies_vimeo.txt

# کوکی عمومی (fallback اگر کوکی اختصاصی پلتفرم نبود)
# COOKIES_FILE=/data/cookies.txt

# ---- روش جایگزین برای Railway ----
# به جای آپلود فایل، محتوای cookies.txt را base64 کن و اینجا بذار
# در startup خودکار decode و ذخیره می‌شه
# COOKIES_YOUTUBE_B64=<base64 encoded content of cookies_youtube.txt>
# COOKIES_INSTAGRAM_B64=<base64 encoded content>
# COOKIES_TWITTER_B64=<base64 encoded content>
# COOKIES_TIKTOK_B64=<base64 encoded content>
# COOKIES_FACEBOOK_B64=<base64 encoded content>

# تنظیمات مربوط به API کبالت و RapidAPI (معماری دولایه)
USE_COBALT_API=True
# چنانچه سرور عمومی دچار محدودیت شد، می‌توانید آدرس یک نمونه (Instance) دیگر از کبالت را در اینجا تنظیم کنید.
COBALT_API_URL=https://api.cobalt.tools/
# توکن احراز هویت نمونه اختصاصی کبالت (در صورت نیاز)
COBALT_API_JWT=

# ---- YouTube: عبور از bot-check ----
# yt-dlp روی IP دیتاسنتر (مثل Railway) توسط یوتیوب چالش می‌شود.
# راه درست، کوکی نیست — کوکی مرورگر کل نشست حساب گوگل است، نه فقط یوتیوب.
#
# ۱) PO Token: پکیج bgutil-ytdlp-pot-provider پلاگین را ثبت می‌کند، ولی به یک
#    سرور Node نیاز دارد که توکن را لحظه‌ای بسازد. سرویس bgutil را جدا بالا بیاور
#    و آدرس داخلی‌اش را اینجا بگذار. خالی بماند، پلاگین 127.0.0.1:4416 را امتحان می‌کند.
BGUTIL_POT_BASE_URL=

# ۲) پروکسی خروجی. یوتیوب URL رسانه را با IP درخواست‌کننده امضا می‌کند، پس
#    متادیتا و خود فایل هر دو باید از یک IP بروند — نمی‌شود فقط بخش کوچک را پروکسی کرد.
YTDLP_PROXY=

# فقط برای دیباگ دستی یک توکن. مکانیزم نیست: چند ساعته منقضی می‌شود.
# YOUTUBE_PO_TOKEN=
# YOUTUBE_VISITOR_DATA=

# تنظیمات اکانت تجاری RapidAPI (در صورت فعال‌سازی، دانلودهای توییتر از اینجا عبور می‌کنند)
USE_RAPIDAPI=False
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=twitter-video-downloader.p.rapidapi.com
RAPIDAPI_YT_HOST=youtube-info-download-api.p.rapidapi.com

# --- Stripe Payment Settings ---
# توقف ذخیره‌سازی نامن: هرگز مقادیر زیر را در فایل settings.json وارد نکنید وحتما به عنوان متغیر سیستم‌عامل ذخیره کنید
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ===== UserBot — Save Restricted Content =====
# برای دانلود محتوای پروتکت‌شده تلگرام (کانال‌ها با forwarding غیرفعال)
# این متغیرها را از https://my.telegram.org تهیه کنید
TG_API_ID=
TG_API_HASH=
# Session String را با اجرای python generate_session.py یکبار تولید کنید
# و مقدار آن را اینجا قرار دهید (برای استفاده در Railway)
TG_SESSION_STRING=

# کانال واسطه برای عبور از محدودیت ۵۰ مگابایتی Bot API
# فایل‌های بزرگ توسط UserBot اینجا آپلود و سپس برای کاربر copy می‌شوند
# ⚠️ بات هم باید عضو این کانال باشد وگرنه copy_message شکست می‌خورد
# بدون این متغیر، هر فایل بالای ۵۰MB رد می‌شود
DUMP_CHANNEL_ID=
